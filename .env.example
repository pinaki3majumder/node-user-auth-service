# Sample environment variables for Node User Auth Service

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=yourpassword
DB_NAME=node_user_auth_db

# JWT Secrets
JWT_ACCESS_SECRET=your_access_secret_key
JWT_REFRESH_SECRET=your_refresh_secret_key

# Token Expiry (in minutes)
JWT_ACCESS_EXPIRES_IN=3m
JWT_REFRESH_EXPIRES_IN=6m

# Server
PORT=3000
